# dsh-vision-dashscope 配置（复制为 .env 后填写）
# API Key（也可用环境变量 DASH_VISION_API_KEY；缺省回退 OMNIMODAL_API_KEY / DASHSCOPE_API_KEY）
DASH_VISION_API_KEY=

# 模型（默认均为 DashScope 千问系列）
# DASH_VISION_IMAGE_MODEL=qwen3.7-flash
# DASH_VISION_VIDEO_MODEL=qwen3.7-flash
# DASH_VISION_AUDIO_MODEL=qwen3.5-omni-flash
# DASH_VISION_ASR_MODEL=fun-asr
# DASH_VISION_LANGUAGE=zh

# 端点（一般无需修改）
# DASH_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASH_VISION_NATIVE_BASE_URL=https://dashscope.aliyuncs.com

# 限制
# DASH_VISION_VIDEO_BASE64_MAX_MB=14     # 超出走临时 OSS 直传（上限 1GB）
# DASH_VISION_AUDIO_OMNI_MAX_SEC=300     # 长音频转写阈值
# DASH_VISION_MAX_TOKENS=4096

# 生成（默认均为 DashScope 千问/万相系列）
# DASH_VISION_IMAGE_GEN_MODEL_STANDARD=qwen-image-3.0
# DASH_VISION_IMAGE_GEN_MODEL_PRO=wan2.7-image-pro
# DASH_VISION_IMAGE_GEN_MODEL_MAX=qwen-image-3.0-pro
# DASH_VISION_VIDEO_GEN_MODEL_STANDARD_T2V=wan2.7-t2v
# DASH_VISION_VIDEO_GEN_MODEL_MAX_T2V=happyhorse-1.1-t2v
# DASH_VISION_VIDEO_GEN_MODEL_STANDARD_I2V=wan2.7-i2v
# DASH_VISION_VIDEO_GEN_MODEL_MAX_I2V=happyhorse-1.1-i2v
# DASH_VISION_OUTPUT_DIR=~/Downloads/dsh-vision-dashscope   # 生成结果保存目录
# DASH_VISION_MAX_VIDEO_DURATION=10      # 视频生成时长上限（秒）

# 生图 JPEG 预览（额外转一张，保留原图）
# DASH_VISION_IMAGE_PREVIEW_JPEG=1       # 0 关闭
# DASH_VISION_IMAGE_PREVIEW_MAX_DIM=1600 # 预览最长边（像素）
# DASH_VISION_IMAGE_PREVIEW_QUALITY=85   # JPEG 质量
